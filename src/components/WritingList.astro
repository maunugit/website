---
import type { CollectionEntry } from 'astro:content';
import { formatDate, readingTime, url } from '../lib/writing';
interface Props { entries: CollectionEntry<'writing'>[]; }
const { entries } = Astro.props;
---
{entries.length ? (
  <ol class="writing-list">
    {entries.map((entry) => (
      <li>
        <div class="entry-meta">
          {entry.data.draft ? <span>draft</span> : <time datetime={entry.data.date.toISOString()}>{formatDate(entry.data.date)}</time>}
          <span>{readingTime(entry.body)} min</span>
        </div>
        <div class="entry-content">
          <h2><a href={url(`writing/${entry.id}/`)}>{entry.data.title}</a></h2>
        </div>
      </li>
    ))}
  </ol>
) : <p class="empty-writing">Nothing published yet.</p>}
