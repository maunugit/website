---
import '../styles/global.css';
import { site } from '../data/site';
import { url } from '../lib/writing';
interface Props { title?: string; description?: string; draft?: boolean; home?: boolean; }
const { title, description = site.introduction, draft = false, home = false } = Astro.props;
const pageTitle = title ? `${title} — ${site.name}` : `${site.name} — Notes on software & AI`;
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site) : undefined;
const nav = [{ label: 'Home', path: '' }, { label: 'Writing', path: 'writing/' }, { label: 'About / Coding', path: 'about/' }];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#ffffff" />
    {draft && <meta name="robots" content="noindex, nofollow" />}
    {canonical && <link rel="canonical" href={canonical} />}
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={Astro.url.pathname.includes('/writing/') && title !== 'Writing' ? 'article' : 'website'} />
    {canonical && <meta property="og:url" content={canonical} />}
    <link rel="icon" href={url('favicon.svg')} type="image/svg+xml" />
  </head>
  <body class:list={{ 'is-home': home }}>
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="site-shell">
      <header class="site-header">
        {home ? <h1 class="site-name"><a href={url()}>{site.name}</a></h1> : <p class="site-name"><a href={url()}>{site.name}</a></p>}
        <p class="site-description">{site.description}</p>
        <nav aria-label="Main navigation">
          {nav.map(({ label, path }) => {
            const active = path ? Astro.url.pathname.startsWith(url(path)) || (path === 'about/' && Astro.url.pathname.startsWith(url('coding/'))) : Astro.url.pathname === url();
            return <a href={url(path)} aria-current={active ? 'page' : undefined}>{label}</a>;
          })}
        </nav>
      </header>
      <main id="main" tabindex="-1"><slot /></main>
    </div>
  </body>
</html>
