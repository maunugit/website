---
import Base from '../layouts/Base.astro';
import { url } from '../lib/writing';
---
<Base title="Page not found">
  <section class="intro">
    <p class="eyebrow">404</p>
    <h1>Nothing here.</h1>
    <p class="intro-copy">This page may have moved, or the link might be incomplete.</p>
    <a class="text-link" href={url()}>Back to the homepage <span aria-hidden="true">↗</span></a>
  </section>
</Base>
