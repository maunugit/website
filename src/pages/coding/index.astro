---
import Base from '../../layouts/Base.astro';
import { site, projects } from '../../data/site';
import { url } from '../../lib/writing';
---
<Base title="Coding">
  <header class="section-heading">
    <h1>Coding</h1>
  </header>
  <div class="coding-content">
    <div class="prose">
      {site.introduction && <p>{site.introduction}</p>}
      <p>Here are some of my personal and work-related coding projects.</p>
    </div>
    <section id="coding" class="coding" aria-labelledby="coding-heading">
      <h2 id="coding-heading">Projects</h2>
      <ul class="project-list">
        {projects.map(project => <li>
          <h3>{project.page ? <a href={url(project.page)}>{project.name}</a> : project.href ? <a href={project.href.startsWith('/') ? url(project.href) : project.href}>{project.name}</a> : project.name}</h3>
          <p>{project.description}</p>
          <div class="project-meta">
            <span class="small-meta">{project.kind}</span>
            {project.page && <a href={url(project.page)}>Project notes</a>}
            {project.href && <a href={project.href.startsWith('/') ? url(project.href) : project.href} aria-label={`${project.name} on GitHub`}>GitHub</a>}
          </div>
        </li>)}
      </ul>
    </section>
    {site.links.length > 0 && <nav class="elsewhere" aria-label="Elsewhere">{site.links.map(link => <a href={link.href.startsWith('/') ? url(link.href) : link.href}>{link.label}</a>)}</nav>}
  </div>
</Base>
